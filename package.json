{
  "name": "the-useful-parts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "NODE_ENV=production bun .output/server/index.mjs",
    "check": "oxlint --type-aware && oxfmt --check",
    "fix": "oxlint --type-aware --fix && oxfmt",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "bun test src tests/integration",
    "test:e2e": "playwright test",
    "verify": "bun run check && bun run typecheck && bun run knip && bun run test && bun run build && bun run test:e2e && bun run test:e2e:dev",
    "hooks": "git config core.hooksPath .githooks",
    "intent": "intent",
    "test:e2e:dev": "E2E_MODE=development playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@orpc/client": "2.0.0-beta.53",
    "@orpc/server": "2.0.0-beta.53",
    "@orpc/tanstack-query": "2.0.0-beta.53",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.82.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@babel/core": "8.1.3",
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/intent": "0.5.6",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-query-devtools": "5.108.4",
    "@tanstack/react-router-devtools": "1.167.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "knip": "6.48.0",
    "nitro": "3.0.261103-rc",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "shadcn": "4.23.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "ultracite": "8.3.1",
    "vite": "8.3.8"
  },
  "engines": {
    "bun": "1.4.5"
  },
  "packageManager": "bun@1.4.5",
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/react-router",
      "@tanstack/router-core",
      "@tanstack/devtools",
      "@tanstack/devtools-vite",
      "ultracite"
    ]
  }
}
